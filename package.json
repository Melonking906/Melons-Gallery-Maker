{
    "dependencies": {
        "async-neocities": "^4.1.2",
        "electron-json-storage": "^4.6.0",
        "fs-extra": "^11.4.0",
        "html-minifier": "^4.0.0",
        "html-prettify": "^1.0.7",
        "lodash": "^4.18.1",
        "luxon": "^3.7.2",
        "path": "^0.12.7",
        "request": "^2.88.2",
        "sanitize-filename": "^1.6.4",
        "sharp": "^0.35.3"
    },
    "name": "MelonsGalleryMaker",
    "productName": "Melon's Gallery Maker",
    "version": "0.0.3",
    "description": "A little static HTML gallery generator!",
    "main": "main.js",
    "devDependencies": {
        "electron": "^39.8.10",
        "electron-builder": "^26.15.3",
        "electron-squirrel-startup": "^1.0.1"
    },
    "scripts": {
        "start": "electron .",
        "test": "echo \"Error: no test specified\" && exit 1",
        "pack": "electron-builder --dir",
        "dist": "electron-builder"
    },
    "author": "Melonking",
    "license": "ISC",
    "packageManager": "yarn@3.6.3",
    "build": {
        "appId": "net.melonking.${name}",
        "executableName": "melons-gallery-maker",
        "asarUnpack": [
            "node_modules/**"
        ],
        "extraResources": [
            {
                "from": "./assets",
                "to": "./assets",
                "filter": [
                    "**/*"
                ]
            }
        ],
        "mac": {
            "category": "public.app-category.developer-tools",
            "extraDistFiles": [
                "./extras/*"
            ]
        },
        "win": {
            "target": "portable"
        },
        "linux": {}
    }
}
